  "entrypoints": {
    "main": [
      "net.bandit.fabric.hyrule_terrorsHyruleTerrorsModFabric"
    ],
    "client": [
      "net.bandit.fabric.client.hyrule_terrorsHyruleTerrorsModFabricClient"
    ],
    "modmenu": [
